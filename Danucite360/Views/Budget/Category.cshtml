@model Danucite360.Services.Models.CategoryDetailServiceModel

@{
    ViewData["Title"] = "Разходи: " + Model.CategoryName;

    var maxAmount = Model.Regions.Any() ? Model.Regions.Max(r => r.Amount) : 1m;
}

<section class="page-shell">
    <div class="page-header mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-demo">Демо данни</span>
                <span class="last-updated">Бюджет @Model.BudgetYear</span>
            </div>
            <div class="d-flex align-items-center gap-3">
                <div>
                    <h1 class="section-title mb-1">@Model.CategoryName</h1>
                    <p class="section-subtitle mb-0">Колко се харчи и как се разпределя по области.</p>
                </div>
            </div>
        </div>

        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-sm" asp-controller="Budget" asp-action="Categories">
                ← Всички области
            </a>
        </div>
    </div>

    <partial name="_DemoNotice" />

    <div class="row g-4 my-1">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Общо разходи</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.TotalAmount)</div>
                <div class="kpi-meta">В @Model.Regions.Count области</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Дял от демо разходите</div>
                <div class="kpi-value">@MoneyFormatter.FormatPercent(Model.Percentage)</div>
                <div class="kpi-meta">От всички демо регионални разходи</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">На човек</div>
                <div class="kpi-value">@Model.PerCapita.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG")) €</div>
                <div class="kpi-meta">На жител годишно</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Обхванати области</div>
                <div class="kpi-value">@Model.Regions.Count</div>
                <div class="kpi-meta">Демо набор за сравнение</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">По области</h2>
                    <p class="text-muted small">Демо разходи по области.</p>

                    <div class="revenue-bars mt-3">
                        @foreach (var r in Model.Regions.OrderByDescending(r => r.Amount))
                        {
                            var pct = Model.TotalAmount == 0 ? 0 : (double)(r.Amount / Model.TotalAmount) * 100;
                            <div class="revenue-bar-row">
                                <span class="revenue-bar-label">
                                    <a class="text-decoration-none" href="/regions/@r.RegionSlug">@r.RegionName</a>
                                </span>
                                <div class="revenue-bar-track">
                                    <span style="width:@(((double)(r.Amount / maxAmount) * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                </div>
                                <span class="revenue-bar-value mono">@MoneyFormatter.FormatThousandEur(r.Amount) · @MoneyFormatter.FormatPercent((decimal)pct)</span>
                            </div>
                        }
                    </div>

                    <div class="source-ref demo">Източник: демонстрационно разпределение</div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Разлики между областите</h2>
                    <p class="text-muted small">Разходи на човек спрямо средното (@Model.PerCapita.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG")) €).</p>

                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Област</th>
                                    <th class="num">На човек (€)</th>
                                    <th class="num">Спрямо средното</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model.Regions)
                                {
                                    <tr>
                                        <td><a class="text-decoration-none" href="/regions/@r.RegionSlug">@r.RegionName</a></td>
                                        <td class="num">@r.PerCapita.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG")) €</td>
                                        <td class="num">
                                            <span class="vs-avg @(r.VsAveragePercent >= 0 ? "vs-up" : "vs-down")">
                                                @(r.VsAveragePercent >= 0 ? "▲ +" : "▼ ")@MoneyFormatter.FormatPercent(r.VsAveragePercent)
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card mt-4">
        <div class="app-card-body">
            <h2 class="card-heading h5">Какво включва тази област</h2>
            <p class="mb-0 text-secondary">@GetCategoryDescription(Model.CategorySlug)</p>
        </div>
    </div>
</section>

@functions {
    private static string GetCategoryIcon(string slug)
    {
        return slug switch
        {
            "healthcare" => "✚",
            "education" => "📘",
            "infrastructure" => "▣",
            "social-support" => "👥",
            "public-administration" => "🏛",
            "security" => "🛡",
            "environment" => "🌿",
            _ => "●"
        };
    }

    private static string GetCategoryDescription(string slug)
    {
        return slug switch
        {
            "healthcare" => "Здравеопазването включва разходи за държавни и общински болници, медицинска помощ, здравни програми и администрация.",
            "education" => "Образованието включва средства за училища, университети, учители, учебни материали и образователна инфраструктура.",
            "infrastructure" => "Инфраструктурата включва пътища, мостове, обществени работи и комунални съоръжения, които свързват областите.",
            "social-support" => "Социалното подпомагане финансира помощи за домакинства, уязвими групи, семейства и социалната мрежа за сигурност.",
            "public-administration" => "Държавната администрация включва разходите за работата на публичните институции и административните услуги.",
            "security" => "Сигурността включва обществения ред, полицията, спешните служби и защитата на гражданите.",
            "environment" => "Околната среда включва опазване на природата, управление на отпадъците и зелени публични услуги.",
            _ => "Категория разходи в демонстрационния набор данни на Danucite360."
        };
    }
}
