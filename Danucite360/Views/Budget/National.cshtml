@model Danucite360.Services.Models.NationalBudgetServiceModel

@{
    ViewData["Title"] = "National Budget Overview";
}

<section class="page-shell">
    <div class="page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-official">✓ Official Data</span>
                <span class="last-updated">Last updated: 28 May 2026</span>
            </div>

            <h1 class="section-title mb-2">National Budget Overview</h1>

            <p class="section-subtitle mb-0">
                See how much public money is collected, how much is spent,
                and whether the budget shows a surplus or deficit.
            </p>
        </div>

        <div class="page-actions">
            <button class="btn btn-outline-secondary btn-sm" type="button">
                Share
            </button>
            <button class="btn btn-outline-secondary btn-sm" type="button">
                Export
            </button>
        </div>
    </div>

    <div class="plain-summary mb-4">
        <strong>What does this mean?</strong>
        This overview compares national revenue, expenses, and budget balance for @Model.BudgetYear.
        A negative balance means planned expenses and transfers are higher than revenue.
    </div>

    <div class="filter-bar app-card mb-4">
        <div class="app-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small text-muted">Year</label>
                    <select class="form-select">
                        <option selected>@Model.BudgetYear</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted">Data type</label>
                    <select class="form-select">
                        <option selected>All</option>
                        <option>Official Data</option>
                        <option>Demo Data</option>
                    </select>
                </div>

                <div class="col-md-6 text-md-end">
                    <span class="status-badge status-official">✓ Source referenced</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Total Revenue</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.Revenue)</div>
                <div class="kpi-meta text-success">▲ Revenue, aid &amp; donations</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Total Expenses</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.Expenses)</div>
                <div class="kpi-meta">Planned expenditure &amp; transfers</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Budget Balance</div>
                <div class="kpi-value @(Model.Balance < 0 ? "text-danger" : "text-success")">
                    @MoneyFormatter.FormatThousandEur(Model.Balance)
                </div>
                <div class="kpi-meta">@(Model.Balance < 0 ? "Planned deficit" : "Planned surplus")</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h5 class="card-heading">Revenue vs Expenses vs Balance</h5>
                            <p class="text-muted small mb-0">
                                Loaded from the API using JavaScript fetch and Chart.js.
                            </p>
                        </div>
                        <span class="status-badge status-official">✓ Official Data</span>
                    </div>

                    <canvas id="nationalBudgetChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h5 class="card-heading">Budget relationship</h5>
                    <p class="text-muted">
                        Revenue shows how much money is expected to be collected.
                        Expenses show planned spending. The balance shows the difference.
                    </p>

                    <div class="budget-equation">
                        <div>
                            <span>Revenue</span>
                            <strong>@MoneyFormatter.FormatThousandEur(Model.Revenue)</strong>
                        </div>

                        <div>
                            <span>Expenses</span>
                            <strong>@MoneyFormatter.FormatThousandEur(Model.Expenses)</strong>
                        </div>

                        <div>
                            <span>Balance</span>
                            <strong class="@(Model.Balance < 0 ? "text-danger" : "text-success")">
                                @MoneyFormatter.FormatThousandEur(Model.Balance)
                            </strong>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a class="fw-semibold text-decoration-none"
                           asp-controller="Sources"
                           asp-action="Index">
                            Learn more about sources and methodology →
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h5 class="card-heading">Where does the money come from?</h5>
                    <p class="text-muted small">
                        Primary revenue streams in the @Model.BudgetYear draft budget, by share of total revenue.
                    </p>

                    @{
                        var streams = Model.RevenueBreakdown;
                        var maxStream = streams.Any() ? streams.Max(s => s.Amount) : 1m;
                    }

                    <div class="revenue-bars mt-3">
                        @foreach (var s in streams)
                        {
                            <div class="revenue-bar-row">
                                <span class="revenue-bar-label">@s.CategoryName</span>
                                <div class="revenue-bar-track">
                                    <span style="width:@(((double)(s.Amount / maxStream) * 100).ToString("F1"))%"></span>
                                </div>
                                <span class="revenue-bar-value mono">@MoneyFormatter.FormatThousandEur(s.Amount)</span>
                            </div>
                        }
                    </div>

                    <div class="source-ref">Source: @Model.SourceTitle</div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h5 class="card-heading">Related source</h5>

                    <div class="source-mini-card">
                        <div class="source-icon">📄</div>
                        <div>
                            <strong>@Model.SourceTitle</strong>
                            <p class="text-muted small mb-0">
                                Manually seeded national values from the 2026 draft budget source.
                            </p>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a class="btn btn-outline-primary"
                           asp-controller="Sources"
                           asp-action="Index">
                            View all sources
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var exec = ViewBag.Execution as Danucite360.Services.Models.BudgetExecutionServiceModel;
    }
    @if (exec != null)
    {
        var execLabels = System.Text.Json.JsonSerializer.Serialize(exec.Months.Select(m => m.Month));
        var execValues = System.Text.Json.JsonSerializer.Serialize(exec.Months.Select(m => m.CumulativeRevenue));

        <div class="app-card mt-4">
            <div class="app-card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                    <div>
                        <h5 class="card-heading mb-1">@exec.BudgetYear Budget Execution</h5>
                        <p class="text-muted small mb-0">
                            Actual cumulative execution under the <strong>Consolidated Fiscal Programme</strong> —
                            broader in scope than the State Budget Law plan above (it also covers municipalities,
                            social funds and EU funds).
                        </p>
                    </div>
                    <span class="status-badge status-draft">Actuals · @exec.LatestMonth</span>
                </div>

                <div class="row g-4 my-1">
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-label">Revenue (YTD)</div>
                            <div class="kpi-value">@MoneyFormatter.FormatThousandEur(exec.LatestRevenue)</div>
                            <div class="kpi-meta">Collected to @exec.LatestMonth</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-label">Spending (YTD)</div>
                            <div class="kpi-value">@MoneyFormatter.FormatThousandEur(exec.LatestExpenditure)</div>
                            <div class="kpi-meta">Spent to @exec.LatestMonth</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-label">Balance (YTD)</div>
                            <div class="kpi-value text-danger">@MoneyFormatter.FormatThousandEur(exec.LatestBalance)</div>
                            <div class="kpi-meta">
                                @(exec.LatestBalancePercentGdp.HasValue ? exec.LatestBalancePercentGdp.Value.ToString("N1") + "% of GDP" : "Deficit")
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-3">
                        <div class="kpi-card">
                            <div class="kpi-label">Context</div>
                            <div class="kpi-value" style="font-size:18px;line-height:1.3;">Highest April deficit in 15 years</div>
                            <div class="kpi-meta">Per the Fiscal Council</div>
                        </div>
                    </div>
                </div>

                <div class="region-chart">
                    <canvas id="executionChart"
                            data-labels='@Html.Raw(execLabels)'
                            data-values='@Html.Raw(execValues)'></canvas>
                </div>
                <div class="source-ref">Source: @exec.SourceTitle</div>
            </div>
        </div>
    }
    @{
        var stateExec = ViewBag.StateExecution as Danucite360.Services.Models.StateBudgetExecutionServiceModel;
    }
    @if (stateExec != null)
    {
        var maxRev = stateExec.RevenueBreakdown.Any() ? stateExec.RevenueBreakdown.Max(x => x.Amount) : 1m;
        var maxExp = stateExec.ExpenditureBreakdown.Any() ? stateExec.ExpenditureBreakdown.Max(x => x.Amount) : 1m;

        <div class="app-card mt-4">
            <div class="app-card-body">
                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2 mb-1">
                    <div>
                        <h5 class="card-heading mb-1">State Budget — Where the Money Goes</h5>
                        <p class="text-muted small mb-0">
                            Actual state budget execution to <strong>@stateExec.Period</strong>, by economic type.
                        </p>
                    </div>
                    <span class="status-badge status-draft">Actuals · @stateExec.Period</span>
                </div>

                <div class="row g-4 my-1">
                    <div class="col-6 col-lg-4">
                        <div class="kpi-card">
                            <div class="kpi-label">Revenue (YTD)</div>
                            <div class="kpi-value">@MoneyFormatter.FormatThousandEur(stateExec.Revenue)</div>
                            <div class="kpi-meta">Collected to @stateExec.Period</div>
                        </div>
                    </div>
                    <div class="col-6 col-lg-4">
                        <div class="kpi-card">
                            <div class="kpi-label">Expenditure (YTD)</div>
                            <div class="kpi-value">@MoneyFormatter.FormatThousandEur(stateExec.Expenditure)</div>
                            <div class="kpi-meta">Spent &amp; transferred</div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="kpi-card">
                            <div class="kpi-label">Balance (YTD)</div>
                            <div class="kpi-value text-danger">@MoneyFormatter.FormatThousandEur(stateExec.Balance)</div>
                            <div class="kpi-meta">Deficit, financed by debt issuance</div>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mt-1">
                    <div class="col-lg-6">
                        <h6 class="card-heading" style="font-size:15px;">Revenue by source</h6>
                        <div class="revenue-bars mt-2">
                            @foreach (var r in stateExec.RevenueBreakdown)
                            {
                                <div class="revenue-bar-row">
                                    <span class="revenue-bar-label">@r.CategoryName</span>
                                    <div class="revenue-bar-track"><span style="width:@(((double)(r.Amount / maxRev) * 100).ToString("F1"))%"></span></div>
                                    <span class="revenue-bar-value mono">@MoneyFormatter.FormatThousandEur(r.Amount) · @r.Percentage.ToString("F1")%</span>
                                </div>
                            }
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <h6 class="card-heading" style="font-size:15px;">Expenditure by economic type</h6>
                        <div class="revenue-bars mt-2">
                            @foreach (var e in stateExec.ExpenditureBreakdown)
                            {
                                <div class="revenue-bar-row">
                                    <span class="revenue-bar-label">@e.CategoryName</span>
                                    <div class="revenue-bar-track"><span class="alt" style="width:@(((double)(e.Amount / maxExp) * 100).ToString("F1"))%"></span></div>
                                    <span class="revenue-bar-value mono">@MoneyFormatter.FormatThousandEur(e.Amount) · @e.Percentage.ToString("F1")%</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="source-ref">Source: @stateExec.SourceTitle</div>
            </div>
        </div>
    }
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/chart-theme.js" asp-append-version="true"></script>
    <script src="~/js/national-budget.js" asp-append-version="true"></script>
}