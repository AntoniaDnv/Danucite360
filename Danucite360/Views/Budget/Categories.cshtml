@model IEnumerable<Danucite360.Services.Models.CategorySpendingServiceModel>

@{
    ViewData["Title"] = "Разходи по области";

    var categories = Model.ToList();
    var topCategory = categories.OrderByDescending(c => c.Amount).FirstOrDefault();
    var total = categories.Sum(c => c.Amount);
}

<section class="page-shell">
    <div class="page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-demo">Демо данни</span>
                <span class="last-updated">Бюджет 2026</span>
            </div>

            <h1 class="section-title mb-2">Разходи по области</h1>

            <p class="section-subtitle mb-0">
                Как се разпределят публичните пари между здравеопазване, образование, инфраструктура,
                социално подпомагане, администрация, сигурност и околна среда.
            </p>
        </div>

        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-sm"
               asp-controller="Sources"
               asp-action="Index">
                Източници
            </a>
        </div>
    </div>

    <partial name="_DemoNotice" />

    <div class="plain-summary mb-4">
        <strong>Какво означава това?</strong>
        Разходите са групирани в разбираеми области. В този прототип стойностите идват от демонстрационни
        регионални данни — те показват идеята, а не официалните суми.
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Области</div>
                <div class="kpi-value">@categories.Count</div>
                <div class="kpi-meta">Показани области на разходи</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Общо (демо)</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(total)</div>
                <div class="kpi-meta">Сбор на демо регионалните разходи</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Най-голяма област</div>
                <div class="kpi-value">@topCategory?.CategoryName</div>
                <div class="kpi-meta">
                    @(topCategory == null ? "Няма данни" : MoneyFormatter.FormatPercent(topCategory.Percentage) + " от демо разходите")
                </div>
            </div>
        </div>
    </div>

    <div class="filter-bar app-card mb-4">
        <div class="app-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-muted" for="categorySearch">Търсене</label>
                    <input id="categorySearch" type="search" class="form-control" placeholder="Търсене на област…" />
                </div>

                <div class="col-md-3">
                    <label class="form-label small text-muted">Подреди по</label>
                    <select id="categorySort" class="form-select">
                        <option value="amount" selected>Сума</option>
                        <option value="name">Име</option>
                        <option value="percentage">Дял</option>
                    </select>
                </div>

                <div class="col-md-4 text-md-end">
                    <span class="status-badge status-demo">Демо регионални стойности</span>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="card-heading h5">Дял на всяка област</h2>
                            <p class="text-muted small mb-0">
                                Коя област получава най-голяма част от разходите?
                            </p>
                        </div>

                        <span class="status-badge status-demo">Демо данни</span>
                    </div>

                    <div class="category-chart">
                        <canvas id="categoriesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Най-големи разходи</h2>
                    <p class="text-muted small">
                        Подредени по обща сума за всички демо области.
                    </p>

                    <div class="category-ranking">
                        @foreach (var category in categories.OrderByDescending(c => c.Amount).Take(5))
                        {
                            <div class="category-rank-item"
                                 data-category-name="@category.CategoryName.ToLowerInvariant()"
                                 data-category-amount="@category.Amount"
                                 data-category-percentage="@category.Percentage">
                                <div>
                                    <strong>@category.CategoryName</strong>
                                    <span>@MoneyFormatter.FormatPercent(category.Percentage) от демо разходите</span>
                                </div>

                                <div>
                                    <strong>@MoneyFormatter.FormatThousandEur(category.Amount)</strong>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="card-heading h5">Всички области</h2>
                    <p class="text-muted small mb-0">
                        Какво включва всяка област, на разбираем език.
                    </p>
                </div>
            </div>

            <div class="category-card-grid" id="categoryGrid">
                @foreach (var category in categories.OrderByDescending(c => c.Amount))
                {
                    <a class="category-info-card"
                       href="/budget/categories/@category.CategorySlug"
                       data-category-name="@category.CategoryName.ToLowerInvariant()"
                       data-category-amount="@category.Amount"
                       data-category-percentage="@category.Percentage">

                        <div>
                            <h6>@category.CategoryName</h6>
                            <p>@GetCategoryDescription(category.CategorySlug)</p>

                            <div class="category-card-meta">
                                <span>@MoneyFormatter.FormatThousandEur(category.Amount)</span>
                                <span>@MoneyFormatter.FormatPercent(category.Percentage)</span>
                                <span class="view-detail">Подробно →</span>
                            </div>
                        </div>
                    </a>
                }
            </div>
        </div>
    </div>
</section>

@functions {
    private static string GetCategoryIcon(string slug)
    {
        return slug switch
        {
            "healthcare" => "✚",
            "education" => "📘",
            "infrastructure" => "▣",
            "social-support" => "👥",
            "public-administration" => "🏛",
            "security" => "🛡",
            "environment" => "🌿",
            _ => "●"
        };
    }

    private static string GetCategoryDescription(string slug)
    {
        return slug switch
        {
            "healthcare" => "Публични разходи за здравни услуги и медицинска помощ.",
            "education" => "Средства за училища, образователни услуги и учебна инфраструктура.",
            "infrastructure" => "Разходи за пътища, обществени работи и инфраструктура.",
            "social-support" => "Програми в подкрепа на домакинства, уязвими групи и социални услуги.",
            "public-administration" => "Административни услуги и управление на публичния сектор.",
            "security" => "Обществен ред, сигурност и свързаните системи.",
            "environment" => "Опазване на околната среда и зелени публични услуги.",
            _ => "Категория разходи в демонстрационния набор данни."
        };
    }
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/chart-theme.js" asp-append-version="true"></script>
    <script src="~/js/categories.js" asp-append-version="true"></script>
}