@using Danucite360.Common.Constants
@{
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavActive(bool isActive) => isActive ? "nav-link active" : "nav-link";
    var overviewActive = routeController == "Home" && routeAction == "Index";
    var projectsActive = routeController == "Projects";
    var regionsActive = routeController == "Map" || routeController == "Regions";
    var categoriesActive = routeController == "Budget" && routeAction == "Categories";
    var fundingActive = routeController == "Funding";
    var debtActive = routeController == "Debt";
    var sourcesActive = routeController == "Sources";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Danucite360</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">D</span>
                    <span>
                        Danucite360
                        <span class="brand-subtitle d-none d-md-block">See where public money goes.</span>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item">
                            <a class="@NavActive(overviewActive)" asp-area="" asp-controller="Home" asp-action="Index">Overview</a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavActive(projectsActive)" asp-area="" asp-controller="Projects" asp-action="Index">Projects</a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavActive(regionsActive)" asp-area="" asp-controller="Map" asp-action="Index">Regions</a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavActive(categoriesActive)" asp-area="" asp-controller="Budget" asp-action="Categories">Categories</a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavActive(fundingActive)" asp-area="" asp-controller="Funding" asp-action="Index">Funding</a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavActive(debtActive)" asp-area="" asp-controller="Debt" asp-action="Index">Debt</a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavActive(sourcesActive)" asp-area="" asp-controller="Sources" asp-action="Index">Sources</a>
                        </li>

                        @if (User.IsInRole(RoleConstants.Admin))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <div class="nav-search d-none d-lg-block">
                            <input type="search" aria-label="Search" placeholder="Search data…" disabled />
                        </div>

                        <span class="live-status d-none d-md-inline-flex" title="Prototype data feed">Live Status</span>

                        <div class="language-switcher d-none d-md-flex">
                            <span>BG</span>
                            <span class="active">EN</span>
                        </div>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="app-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-mark">D</span>
                        <strong>Danucite360</strong>
                    </div>
                    <p class="footer-text">
                        Civic budget transparency for a stronger Bulgaria.
                    </p>
                    <p class="footer-text mb-0">
                        © 2026 Danucite360. All rights reserved.
                    </p>
                </div>

                <div class="col-6 col-md-2">
                    <h6>Explore</h6>
                    <a asp-area="" asp-controller="Budget" asp-action="National">National Budget</a>
                    <a asp-area="" asp-controller="Map" asp-action="Index">Regions</a>
                    <a asp-area="" asp-controller="Budget" asp-action="Categories">Categories</a>
                    <a asp-area="" asp-controller="Sources" asp-action="Index">Sources</a>
                </div>

                <div class="col-6 col-md-2">
                    <h6>About</h6>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">About Danucite360</a>
                    <a asp-area="" asp-controller="Sources" asp-action="Index">Methodology</a>
                    <a asp-area="" asp-controller="Sources" asp-action="Index">Data Sources</a>
                </div>

                <div class="col-6 col-md-2">
                    <h6>Legal</h6>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy Policy</a>
                    <a asp-area="" asp-controller="Sources" asp-action="Index">Data Disclaimer</a>
                </div>

                <div class="col-6 col-md-2">
                    <h6>Data Status</h6>
                    <span class="status-badge status-official mb-2">✓ Official Data</span>
                    <span class="status-badge status-demo">⚠ Demo Data</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>