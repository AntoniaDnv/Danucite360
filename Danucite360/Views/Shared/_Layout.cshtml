@using Danucite360.Common.Constants
@{
    var routeController = ViewContext.RouteData.Values["controller"]?.ToString();
    var routeAction = ViewContext.RouteData.Values["action"]?.ToString();
    string NavActive(bool isActive) => isActive ? "nav-link active" : "nav-link";
    var overviewActive = routeController == "Home" && routeAction == "Index";
    var budgetActive = routeController == "Budget";
    var projectsActive = routeController == "Projects" || routeController == "Funding";
    var regionsActive = routeController == "Map" || routeController == "Regions";
    var measuresActive = routeController == "Measures";
    var debtActive = routeController == "Debt";
    var sourcesActive = routeController == "Sources" || routeController == "OpenData";
}

<!DOCTYPE html>
<html lang="bg">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Danucite360</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800&family=JetBrains+Mono:wght@400;500;600&display=swap" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/civic.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="app-header">
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
            <div class="container-fluid px-4">
                <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-mark">D</span>
                    <span>
                        Danucite360
                        <span class="brand-subtitle d-none d-md-block">Виж къде отиват публичните пари.</span>
                    </span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Меню">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav mx-auto gap-lg-2">
                        <li class="nav-item"><a class="@NavActive(overviewActive)" asp-area="" asp-controller="Home" asp-action="Index">Начало</a></li>
                        <li class="nav-item"><a class="@NavActive(budgetActive)" asp-area="" asp-controller="Budget" asp-action="National">Бюджет</a></li>
                        <li class="nav-item"><a class="@NavActive(projectsActive)" href="/projects/map">Проекти</a></li>
                        <li class="nav-item"><a class="@NavActive(measuresActive)" href="/measures">Какво се променя</a></li>
                        <li class="nav-item"><a class="@NavActive(regionsActive)" asp-area="" asp-controller="Map" asp-action="Index">Региони</a></li>
                        <li class="nav-item"><a class="@NavActive(debtActive)" asp-area="" asp-controller="Debt" asp-action="Index">Дълг</a></li>
                        <li class="nav-item"><a class="@NavActive(sourcesActive)" asp-area="" asp-controller="Sources" asp-action="Index">Източници</a></li>
                        @if (User.IsInRole(RoleConstants.Admin))
                        {
                            <li class="nav-item"><a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Администрация</a></li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-3">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="app-footer mt-5">
        <div class="container py-5">
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <span class="brand-mark">D</span>
                        <strong>Danucite360</strong>
                    </div>
                    <p class="footer-text">Публичните финанси на България — разбираемо, проверимо и отворено.</p>
                    <p class="footer-text mb-0">© 2026 Danucite360. Граждански прототип, не е държавен сайт.</p>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Бюджет</h6>
                    <a asp-area="" asp-controller="Budget" asp-action="National">Държавен бюджет</a>
                    <a asp-area="" asp-controller="Budget" asp-action="Categories">Разходи по области</a>
                    <a asp-area="" asp-controller="Debt" asp-action="Index">Държавен дълг</a>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Проекти и мерки</h6>
                    <a href="/projects/map">Карта на проектите</a>
                    <a href="/projects/explorer">Всички проекти</a>
                    <a asp-area="" asp-controller="Funding" asp-action="Index">Източници на финансиране</a>
                    <a href="/measures">Регистър на мерките</a>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Данни</h6>
                    <a asp-area="" asp-controller="Sources" asp-action="Index">Източници и методология</a>
                    <a href="/open-data">Отворени данни (CSV / JSON)</a>
                    <a asp-area="" asp-controller="Home" asp-action="Privacy">Поверителност</a>
                </div>
                <div class="col-6 col-md-2">
                    <h6>Статус на данните</h6>
                    <span class="status-badge status-official mb-2">Официални данни</span>
                    <span class="status-badge status-demo">Демо данни</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>