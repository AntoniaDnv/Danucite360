@model ErrorViewModel
@{
    ViewData["Title"] = "Грешка";
}

<section class="page-shell">
    <h1 class="section-title mb-2">Нещо се обърка</h1>
    <p class="section-subtitle">Възникна грешка при обработката на заявката. Опитайте отново или се върнете към <a href="/">началната страница</a>.</p>
    @if (Model.ShowRequestId)
    {
        <p class="small text-muted">Код на заявката: <code>@Model.RequestId</code></p>
    }
</section>
