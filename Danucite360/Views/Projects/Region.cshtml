@model Danucite360.Services.Models.RegionProjectsServiceModel

@{
    ViewData["Title"] = Model.RegionName + " Projects";
    var maxCat = Model.ByCategory.Any() ? Model.ByCategory.Max(c => c.Amount) : 1m;

    string StatusClass(string s) => s switch
    {
        "Completed" => "status-official",
        "Ongoing" => "status-ongoing",
        _ => "status-draft"
    };
}

<section class="page-shell">
    <nav class="breadcrumbs mb-2">
        <a asp-controller="Projects" asp-action="Explorer">Projects</a>
        <span>›</span>
        <span>@Model.RegionName</span>
    </nav>

    <div class="page-header mb-4">
        <div>
            <h1 class="section-title mb-1">@Model.RegionName District</h1>
            <p class="section-subtitle mb-0">Regional investment overview and project execution tracking.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-sm" href="/regions/@Model.RegionSlug">Spending dashboard →</a>
        </div>
    </div>

    <partial name="_DemoNotice" />

    <div class="row g-4 my-1">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Total Active Projects</div>
                <div class="kpi-value">@Model.ActiveProjects</div>
                <div class="kpi-meta">Ongoing or planned</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Total Allocated Budget</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.TotalBudget)</div>
                <div class="kpi-meta">All tracked projects</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Sectors</div>
                <div class="kpi-value">@Model.ByCategory.Count</div>
                <div class="kpi-meta">Investment areas</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Projects Tracked</div>
                <div class="kpi-value">@Model.Projects.Count</div>
                <div class="kpi-meta">In @Model.BudgetYear</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h5 class="card-heading">Budget by Category</h5>
                    <div class="revenue-bars mt-3">
                        @foreach (var cat in Model.ByCategory)
                        {
                            <div class="revenue-bar-row">
                                <span class="revenue-bar-label">@cat.Name</span>
                                <div class="revenue-bar-track">
                                    <span style="width:@(((double)(cat.Amount / maxCat) * 100).ToString("F1"))%"></span>
                                </div>
                                <span class="revenue-bar-value mono">@cat.Percent.ToString("F0")%</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h5 class="card-heading">Major Active Projects</h5>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Project</th>
                                    <th>Category</th>
                                    <th class="num">Budget</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Projects)
                                {
                                    <tr>
                                        <td><a class="fw-semibold text-decoration-none" href="/projects/@p.Slug">@p.Title</a></td>
                                        <td>@p.ProjectType</td>
                                        <td class="num">@MoneyFormatter.FormatThousandEur(p.Budget)</td>
                                        <td><span class="status-badge @StatusClass(p.Status)">@p.Status</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
