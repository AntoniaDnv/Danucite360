@model Danucite360.Services.Models.RegionProjectsServiceModel
@using Danucite360.Common.Constants

@{
    ViewData["Title"] = "Проекти — " + Model.RegionName;
    var maxCat = Model.ByCategory.Any() ? Model.ByCategory.Max(c => c.Amount) : 1m;

    string StatusClass(string s) => s switch
    {
        "Completed" => "status-official",
        "Ongoing" => "status-ongoing",
        _ => "status-draft"
    };
}

<section class="page-shell">
    <nav class="breadcrumbs mb-2">
        <a href="/projects/map">Проекти</a>
        <span>›</span>
        <span>@Model.RegionName</span>
    </nav>

    <div class="page-header mb-4">
        <div>
            <h1 class="section-title mb-1">Област @Model.RegionName</h1>
            <p class="section-subtitle mb-0">Публични инвестиции в областта и докъде са стигнали проектите.</p>
        </div>
        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-sm" href="/regions/@Model.RegionSlug">Разходи на областта →</a>
        </div>
    </div>

    <partial name="_DemoNotice" />

    <div class="row g-4 my-1">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Активни проекти</div>
                <div class="kpi-value">@Model.ActiveProjects</div>
                <div class="kpi-meta">В изпълнение или подготовка</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Общ бюджет</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.TotalBudget)</div>
                <div class="kpi-meta">На всички проекти</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Сектори</div>
                <div class="kpi-value">@Model.ByCategory.Count</div>
                <div class="kpi-meta">Области на инвестиции</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Проследявани проекти</div>
                <div class="kpi-value">@Model.Projects.Count</div>
                <div class="kpi-meta">През @Model.BudgetYear г.</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Бюджет по сектори</h2>
                    <div class="revenue-bars mt-3">
                        @foreach (var cat in Model.ByCategory)
                        {
                            <div class="revenue-bar-row">
                                <span class="revenue-bar-label">@Labels.ToBg(cat.Name)</span>
                                <div class="revenue-bar-track">
                                    <span style="width:@(((double)(cat.Amount / maxCat) * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                </div>
                                <span class="revenue-bar-value mono">@MoneyFormatter.FormatPercent(cat.Percent, 0)</span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Проекти в областта</h2>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Проект</th>
                                    <th>Сектор</th>
                                    <th class="num">Бюджет</th>
                                    <th>Статус</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Projects)
                                {
                                    <tr>
                                        <td><a class="fw-semibold text-decoration-none" href="/projects/@p.Slug">@p.Title</a></td>
                                        <td>@Labels.ToBg(p.ProjectType)</td>
                                        <td class="num">@MoneyFormatter.FormatThousandEur(p.Budget)</td>
                                        <td><span class="status-badge @StatusClass(p.Status)">@Labels.ToBg(p.Status)</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
