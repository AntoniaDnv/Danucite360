@model Danucite360.Services.Models.ProjectDetailServiceModel
@using Danucite360.Common.Constants

@{
    ViewData["Title"] = Model.Title;

    string StatusClass(string s) => s switch
    {
        "Completed" => "status-official",
        "Ongoing" => "status-ongoing",
        _ => "status-draft"
    };

    // Derive a milestone timeline from completion %.
    var c = Model.CompletionPercent;
    var currentStage = c >= 100 ? 3 : c >= 40 ? 2 : c >= 10 ? 1 : 0;
    var milestones = new[] { "Планиране", "Обществена поръчка", "Изпълнение", "Предаване" };
    var financialPct = Model.Spent.HasValue && Model.Budget > 0 ? (int)Math.Round(Model.Spent.Value / Model.Budget * 100) : (int?)null;
    string StageState(int i) => i < currentStage || c >= 100 ? "done" : i == currentStage ? "current" : "upcoming";

    var maxShare = Model.FundingShares.Any() ? Model.FundingShares.Max(f => f.Amount) : 1m;
}

<section class="page-shell">
    <nav class="breadcrumbs mb-2">
        <a href="/projects/map">Проекти</a>
        <span>›</span>
        @if (Model.RegionSlug != null)
        {
            <a asp-controller="Projects" asp-action="Region" asp-route-slug="@Model.RegionSlug">@Model.RegionName</a>
        }
        else
        {
            <span>Национален обхват</span>
        }
    </nav>

    <div class="page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge @StatusClass(Model.Status)">@Labels.ToBg(Model.Status)</span>
                <span class="project-type-tag">@Labels.ToBg(Model.ProjectType)</span>
                @if (Model.IsDemo)
                {
                    <span class="status-badge status-demo">Демо данни</span>
                }
            </div>
            <h1 class="section-title mb-1">@Model.Title</h1>
            <p class="section-subtitle mb-0">@(Model.City ?? Model.RegionName) · Бюджетна година @Model.BudgetYear</p>
        </div>
        <div class="page-actions">
            <div class="text-md-end">
                <div class="kpi-label">Общ бюджет</div>
                <div class="kpi-value mono">@MoneyFormatter.FormatThousandEur(Model.Budget)</div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="app-card mb-4">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Докъде е стигнал проектът?</h2>
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <span class="text-muted small">Физически напредък — извършена работа</span>
                        <strong class="mono">@Model.CompletionPercent%</strong>
                    </div>
                    <div class="project-progress lg"><span style="width:@Model.CompletionPercent%"></span></div>
                    <div class="d-flex justify-content-between align-items-center mb-1 mt-3">
                        <span class="text-muted small">Финансов напредък — изплатено @(Model.Spent.HasValue ? MoneyFormatter.FormatThousandEur(Model.Spent.Value) : "—") от @MoneyFormatter.FormatThousandEur(Model.Budget)</span>
                        <strong class="mono">@(financialPct.HasValue ? financialPct + "%" : "няма данни")</strong>
                    </div>
                    <div class="project-progress lg financial"><span style="width:@(financialPct ?? 0)%"></span></div>
                    <p class="small text-muted mt-3 mb-0">Двата показателя могат да се различават: работа може да е извършена, но още неплатена, или да е платен аванс преди началото ѝ.</p>
                </div>
            </div>

            <div class="app-card mb-4">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Етапи</h2>
                    <div class="milestones">
                        @for (var i = 0; i < milestones.Length; i++)
                        {
                            var state = StageState(i);
                            <div class="milestone milestone-@state">
                                <div class="milestone-dot">@(state == "done" ? "✓" : (i + 1).ToString())</div>
                                <div class="milestone-label">@milestones[i]</div>
                                <div class="milestone-state">@(state == "done" ? "Завършен" : state == "current" ? "В ход" : "Предстои")</div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="app-card">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Защо е важен този проект</h2>
                    <p class="text-secondary mb-3">@Model.Description</p>
                    <div class="source-ref demo">Статус на данните: демонстрационен запис — проектът, сумите и напредъкът са илюстративни и не са официални данни.</div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Откъде идват парите</h2>
                    <div class="revenue-bars mt-3">
                        @foreach (var f in Model.FundingShares)
                        {
                            <div class="revenue-bar-row">
                                <span class="revenue-bar-label">@Labels.ToBg(f.SourceName)</span>
                                <div class="revenue-bar-track">
                                    <span style="width:@(((double)(f.Amount / maxShare) * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture))%"></span>
                                </div>
                                <span class="revenue-bar-value mono">@MoneyFormatter.FormatThousandEur(f.Amount) · @MoneyFormatter.FormatPercent(f.Percent, 0)</span>
                            </div>
                        }
                    </div>
                    <div class="source-ref demo">Източник: демонстрационно разпределение</div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.RelatedProjects.Any())
    {
        <h2 class="card-heading h5 mt-5 mb-3">Свързани проекти</h2>
        <div class="project-grid">
            @foreach (var p in Model.RelatedProjects)
            {
                <a class="project-card" href="/projects/@p.Slug">
                    <div class="project-card-top">
                        <span class="project-type-tag">@Labels.ToBg(p.ProjectType)</span>
                        <span class="status-badge @StatusClass(p.Status)">@Labels.ToBg(p.Status)</span>
                    </div>
                    <h6 class="project-title">@p.Title</h6>
                    <div class="project-region">@p.RegionName</div>
                    <div class="project-budget mono">@MoneyFormatter.FormatThousandEur(p.Budget)</div>
                </a>
            }
        </div>
    }
</section>
