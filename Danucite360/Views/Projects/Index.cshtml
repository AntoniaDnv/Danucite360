@model Danucite360.Services.Models.ProjectsOverviewServiceModel

@{
    ViewData["Title"] = "Проекти";
}

<section class="page-shell">
    <div class="mb-4">
        <span class="status-badge status-demo">Демо данни (@Model.BudgetYear)</span>
    </div>

    <div class="overview-hero">
        <div class="overview-hero-copy">
            <h1 class="hero-title">Къде отиват данъците ви</h1>
            <p class="hero-subtitle">
                Проследяване на проекти, финансирани с данъци и европейски средства — пътища, болници, училища
                и други инвестиции, които променят България.
            </p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a class="btn btn-primary btn-lg" href="/projects/map">Отвори картата →</a>
                <a class="btn btn-outline-secondary btn-lg" asp-controller="Funding" asp-action="Index">Източници на финансиране</a>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Проследявани проекти</div>
                <div class="kpi-value">@Model.TotalProjects.ToString("N0")</div>
                <div class="kpi-meta">Във всички области</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Обща стойност</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.TotalValue)</div>
                <div class="kpi-meta">Сбор от бюджетите на проектите</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">Области с проекти</div>
                <div class="kpi-value">@Model.ActiveRegions</div>
                <div class="kpi-meta">С поне един финансиран проект</div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="kpi-card">
                <div class="kpi-label">В изпълнение</div>
                <div class="kpi-value">@Model.InProgress</div>
                <div class="kpi-meta">Текущи проекти</div>
            </div>
        </div>
    </div>

    <div class="deep-dive mt-4">
        <div>
            <h4 class="mb-1">Разгледайте всички проекти</h4>
            <p class="mb-0">
                Филтрирайте по област, сектор и статус, за да видите къде точно се инвестират публичните пари.
            </p>
        </div>
        <a class="btn btn-primary" asp-controller="Projects" asp-action="Explorer">Всички проекти →</a>
    </div>
</section>
