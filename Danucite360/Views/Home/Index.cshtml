@model Danucite360.Services.Models.NationalBudgetServiceModel

@{
    ViewData["Title"] = "Начало";

    var revenueStreams = Model.RevenueBreakdown;
    var maxStream = revenueStreams.Any() ? revenueStreams.Max(s => s.Amount) : 1m;
    string Money(decimal v) => MoneyFormatter.FormatThousandEur(v);
    string Pct(decimal part, decimal whole) => (whole == 0 ? 0 : (double)(part / whole) * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);

    var exec = ViewBag.StateExecution as Danucite360.Services.Models.StateBudgetExecutionServiceModel;
    const int monthsElapsed = 4;
    var timePct = (monthsElapsed / 12.0 * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
}

<section class="page-shell overview-page">
    <div class="overview-hero">
        <div class="overview-hero-copy">
            <span class="hero-eyebrow">Публичните финанси на България, разбираемо</span>
            <h1 class="hero-title">
                Не просто колко пари са отпуснати, а <span class="hero-accent">за какво, къде и как</span> се използват
            </h1>
            <p class="hero-subtitle">
                Danucite360 превръща бюджетните таблици и PDF документи в ясни страници, карта на проектите и отворени данни.
                До всяко число стои откъде е и дали е официално.
            </p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Budget" asp-action="National">Разгледай бюджета</a>
                <a class="btn btn-outline-secondary btn-lg" href="/measures">Кои мерки ме засягат</a>
            </div>
        </div>

        @if (exec != null)
        {
            <a class="app-card ledger text-reset text-decoration-none" asp-controller="Budget" asp-action="National" asp-fragment="execution" aria-label="Изпълнение на държавния бюджет — подробно">
                <div class="ledger-head">
                    <h2 class="ledger-title">Планирано срещу случило се</h2>
                    <span class="ledger-period">@exec.Period</span>
                </div>

                <div class="ledger-row">
                    <div class="ledger-row-top"><span>Събрани приходи</span><strong>@Money(exec.Revenue)</strong></div>
                    <div class="ledger-track">
                        <div class="ledger-fill" style="width:@Pct(exec.Revenue, Model.Revenue)%"></div>
                        <div class="ledger-time" style="left:@timePct%"></div>
                    </div>
                    <div class="ledger-row-meta"><span>@MoneyFormatter.FormatPercent(Model.Revenue == 0 ? 0 : exec.Revenue / Model.Revenue * 100) от плана</span><span>план @Money(Model.Revenue)</span></div>
                </div>

                <div class="ledger-row">
                    <div class="ledger-row-top"><span>Похарчени</span><strong>@Money(exec.Expenditure)</strong></div>
                    <div class="ledger-track">
                        <div class="ledger-fill spend" style="width:@Pct(exec.Expenditure, Model.Expenses)%"></div>
                        <div class="ledger-time" style="left:@timePct%"></div>
                    </div>
                    <div class="ledger-row-meta"><span>@MoneyFormatter.FormatPercent(Model.Expenses == 0 ? 0 : exec.Expenditure / Model.Expenses * 100) от плана</span><span>план @Money(Model.Expenses)</span></div>
                </div>

                <div class="ledger-legend"><i aria-hidden="true"></i> Изминали @monthsElapsed от 12 месеца</div>

                <div class="ledger-balance"><span>Дефицит досега</span><strong>@Money(exec.Balance)</strong></div>

                <div class="source-ref">МФ, отчет за изпълнението на държавния бюджет · @exec.Period · официални</div>
            </a>
        }
    </div>

    <div class="row g-4 my-1">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Планирани приходи за @Model.BudgetYear</div>
                <div class="kpi-value">@Money(Model.Revenue)</div>
                <div class="kpi-meta">Данъци, такси, помощи и дарения</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Планирани разходи за @Model.BudgetYear</div>
                <div class="kpi-value">@Money(Model.Expenses)</div>
                <div class="kpi-meta">Всички разходи и трансфери</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Планирано салдо</div>
                <div class="kpi-value @(Model.Balance < 0 ? "text-danger" : "text-success")">@Money(Model.Balance)</div>
                <div class="kpi-meta">@(Model.Balance < 0 ? "Държавата планира да харчи повече, отколкото събира" : "Държавата планира да събере повече, отколкото харчи")</div>
            </div>
        </div>
    </div>

    <h2 class="h5 mt-5 mb-3">Какво можете да направите тук</h2>
    <nav class="contents" aria-label="Съдържание">
        <a asp-controller="Budget" asp-action="National">
            <span class="n">01</span>
            <span><strong>Откъде идват и къде отиват парите</strong>Приходи и разходи по проектобюджета, обяснени на разбираем език</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/projects/map">
            <span class="n">02</span>
            <span><strong>Какво се строи близо до мен</strong>Карта на проектите с бюджет, изплатени суми и напредък</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/measures">
            <span class="n">03</span>
            <span><strong>Кои нови мерки ме засягат</strong>Изберете „Родител“, „Шофьор“ или „Пенсионер“ и вижте какво се променя</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a asp-controller="Budget" asp-action="National" asp-fragment="execution">
            <span class="n">04</span>
            <span><strong>Колко от плана вече е изпълнено</strong>Планирано срещу реално събрано и похарчено към последния отчет</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/open-data">
            <span class="n">05</span>
            <span><strong>Не снимки на таблици, а отворени данни</strong>CSV за Excel и JSON API за журналисти и разработчици</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a asp-controller="Sources" asp-action="Index">
            <span class="n">06</span>
            <span><strong>Откъде са числата</strong>Документите-източници и кое е официално и кое демонстрационно</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
    </nav>

    <div class="row g-4 mt-4">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body d-flex flex-column h-100">
                    <h2 class="card-heading h5">Откъде идват парите</h2>
                    <p class="text-muted small">Най-голям дял има ДДС — данъкът, който плащаме при всяка покупка.</p>
                    <div class="revenue-bars mt-2">
                        @foreach (var s in revenueStreams)
                        {
                            <div class="revenue-bar-row">
                                <span class="revenue-bar-label">@s.CategoryName</span>
                                <div class="revenue-bar-track"><span style="width:@Pct(s.Amount, maxStream)%"></span></div>
                                <span class="revenue-bar-value mono">@Money(s.Amount)</span>
                            </div>
                        }
                    </div>
                    <div class="source-ref">@Model.SourceTitle · план @Model.BudgetYear · официални</div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body d-flex flex-column h-100">
                    <div class="d-flex justify-content-between align-items-start gap-2">
                        <h2 class="card-heading h5">Къде отиват</h2>
                        <span class="status-badge status-demo">Демо</span>
                    </div>
                    <p class="text-muted small">Примерно разпределение по области — илюстрация, не официално.</p>
                    <div class="revenue-bars mt-2" id="spendingList" aria-live="polite"></div>
                    <div class="source-ref demo">Демонстрационно разпределение на Danucite360 · не е официално</div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/chart-theme.js" asp-append-version="true"></script>
    <script src="~/js/home-overview.js" asp-append-version="true"></script>
}
