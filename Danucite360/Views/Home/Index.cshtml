@model Danucite360.Services.Models.NationalBudgetServiceModel

@{
    ViewData["Title"] = "Home";
}

<section class="py-5 bg-light border-bottom">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <span class="badge bg-primary mb-3">MVP Prototype</span>
                <h1 class="display-5 fw-bold mb-3">Danucite360</h1>
                <p class="lead text-muted">
                    A simple public finance transparency dashboard for Bulgaria.
                    Explore national budget values, demo regional spending, categories, and source references.
                </p>

                <div class="d-flex gap-2 flex-wrap mt-4">
                    <a class="btn btn-primary btn-lg" asp-controller="Budget" asp-action="National">
                        View National Budget
                    </a>
                    <a class="btn btn-outline-primary btn-lg" asp-controller="Map" asp-action="Index">
                        Explore Regions
                    </a>
                    <a class="btn btn-outline-secondary btn-lg" asp-controller="Sources" asp-action="Index">
                        View Sources
                    </a>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h5 class="card-title">2026 Budget Snapshot</h5>
                        <p class="text-muted mb-4">Values are shown in @Model.Unit.</p>

                        <div class="mb-3">
                            <div class="small text-muted">Revenue</div>
                            <div class="h4 mb-0">@Model.Revenue.ToString("N1")</div>
                        </div>

                        <div class="mb-3">
                            <div class="small text-muted">Expenses</div>
                            <div class="h4 mb-0">@Model.Expenses.ToString("N1")</div>
                        </div>

                        <div>
                            <div class="small text-muted">Budget Balance</div>
                            <div class="h4 mb-0 @(Model.Balance < 0 ? "text-danger" : "text-success")">
                                @Model.Balance.ToString("N1")
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <partial name="_DemoNotice" />
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5>Simple dashboard</h5>
                        <p class="text-muted mb-0">
                            Turns complicated budget tables into readable cards, charts, and summaries.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5>Regional view</h5>
                        <p class="text-muted mb-0">
                            Compare demo regional spending across Sofia, Plovdiv, Varna, Burgas, Ruse, and Stara Zagora.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5>Source references</h5>
                        <p class="text-muted mb-0">
                            Shows where national values come from and clearly labels demo prototype data.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>