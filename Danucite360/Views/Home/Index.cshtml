@model Danucite360.Services.Models.NationalBudgetServiceModel

@{
    ViewData["Title"] = "Начало";
    string Money(decimal v) => MoneyFormatter.FormatThousandEur(v);
    string Width(decimal part, decimal whole) => (whole == 0 ? 0 : Math.Min(100, (double)(part / whole) * 100)).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
    string Share(decimal part, decimal whole) => MoneyFormatter.FormatPercent(whole == 0 ? 0 : part / whole * 100, 0);

    var exec = ViewBag.StateExecution as Danucite360.Services.Models.StateBudgetExecutionServiceModel;
    const int monthsElapsed = 4;
    var timeLeft = (monthsElapsed / 12.0 * 100).ToString("F1", System.Globalization.CultureInfo.InvariantCulture);
}

<section class="page-shell home">
    <div class="home-hero">
        <div class="home-hero-copy">
            <h1 class="hero-title">Разбери къде отиват публичните пари</h1>
            <p class="hero-subtitle">
                Държавният бюджет, публичните проекти и новите мерки — обяснени на разбираем език,
                с източник до всяко число.
            </p>
            <div class="d-flex gap-3 flex-wrap mt-4">
                <a class="btn btn-primary btn-lg" asp-controller="Budget" asp-action="National">Разгледай бюджета</a>
                <a class="btn btn-outline-secondary btn-lg" href="/projects/map">Виж финансираните проекти</a>
            </div>
        </div>

        <aside class="app-card snapshot" aria-labelledby="snapshotTitle">
            <div class="snapshot-head">
                <h2 class="snapshot-title" id="snapshotTitle">Държавният бюджет за @Model.BudgetYear</h2>
                <span class="status-badge status-official">Официални данни</span>
            </div>

            <div class="snapshot-row">
                <div class="snapshot-line"><span>Приходи · план</span><strong>@Money(Model.Revenue)</strong></div>
                @if (exec != null)
                {
                    <div class="ledger-track"><div class="ledger-fill" style="width:@Width(exec.Revenue, Model.Revenue)%"></div><div class="ledger-time" style="left:@timeLeft%"></div></div>
                    <div class="snapshot-meta">събрани досега @Money(exec.Revenue) · @Share(exec.Revenue, Model.Revenue)</div>
                }
            </div>

            <div class="snapshot-row">
                <div class="snapshot-line"><span>Разходи · план</span><strong>@Money(Model.Expenses)</strong></div>
                @if (exec != null)
                {
                    <div class="ledger-track"><div class="ledger-fill spend" style="width:@Width(exec.Expenditure, Model.Expenses)%"></div><div class="ledger-time" style="left:@timeLeft%"></div></div>
                    <div class="snapshot-meta">похарчени досега @Money(exec.Expenditure) · @Share(exec.Expenditure, Model.Expenses)</div>
                }
            </div>

            <div class="snapshot-row snapshot-balance">
                <div class="snapshot-line"><span>Салдо · план</span><strong class="text-danger">@Money(Model.Balance)</strong></div>
                <div class="snapshot-meta">@(Model.Balance < 0 ? "Дефицит: държавата планира да харчи повече, отколкото събира" : "Излишък")@(exec != null ? " · досега " + Money(exec.Balance) : "")</div>
            </div>

            @if (exec != null)
            {
                <div class="ledger-legend"><i aria-hidden="true"></i> Червената черта: изминали @monthsElapsed от 12 месеца</div>
            }
            <div class="source-ref">План: проектозакон за държавния бюджет @Model.BudgetYear · Изпълнение: МФ, @(exec?.Period ?? "—")</div>
        </aside>
    </div>

    <h2 class="home-section-title">Какво можете да разгледате</h2>
    <nav class="contents" aria-label="Основни раздели">
        <a asp-controller="Budget" asp-action="National">
            <span class="n">01</span>
            <span><strong>Държавният бюджет</strong>Откъде идват парите и за какво се харчат — с обяснения на разбираем език</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/projects/map">
            <span class="n">02</span>
            <span><strong>Финансирани проекти</strong>Карта на проектите с бюджет, изплатени суми и напредък</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a href="/measures">
            <span class="n">03</span>
            <span><strong>Мерки, които ви засягат</strong>Изберете „Родител“, „Шофьор“ или „Пенсионер“ и вижте какво се променя</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
        <a asp-controller="Budget" asp-action="National" asp-fragment="execution">
            <span class="n">04</span>
            <span><strong>Изпълнение през годината</strong>Колко от плана реално е събрано и похарчено към последния отчет</span>
            <span class="arrow" aria-hidden="true">→</span>
        </a>
    </nav>

    <div class="trust">
        <div class="trust-copy">
            <h2 class="home-section-title mt-0">Всяко число има източник</h2>
            <p>
                Стойностите са въведени от официални документи на Министерството на финансите и Народното събрание.
                Където още няма официални данни, показваме демонстрационни стойности — и винаги ги отбелязваме.
            </p>
            <div class="trust-legend">
                <span class="status-badge status-official">Официални данни</span> въведени от публикуван документ
                <span class="status-badge status-demo ms-md-3">Демо данни</span> илюстрация, не се цитира като факт
            </div>
        </div>
        <div class="trust-links">
            <a class="btn btn-outline-secondary" asp-controller="Sources" asp-action="Index">Източници и методология</a>
            <a class="btn btn-outline-secondary" href="/open-data">Изтегли данните (CSV / JSON)</a>
        </div>
    </div>
</section>
