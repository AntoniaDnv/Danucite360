@model Danucite360.Services.Models.RegionDetailsServiceModel

@{
    ViewData["Title"] = $"Област {Model.Name}";
}

<section class="page-shell">
    <div class="mb-4">
        <a class="text-decoration-none fw-semibold"
           asp-controller="Map"
           asp-action="Index">
            ← Сравнение на областите
        </a>
    </div>

    <div class="page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-demo">Демо данни</span>
                <span class="last-updated">Бюджет @Model.BudgetYear</span>
            </div>

            <h1 class="section-title mb-2">Област @Model.Name</h1>

            <p class="section-subtitle mb-0">
                Демонстрационни публични разходи по области за @Model.Name — как би изглеждало
                разбираемо регионално табло.
            </p>
        </div>

        <div class="page-actions">
            <a class="btn btn-outline-secondary btn-sm"
               asp-controller="Sources"
               asp-action="Index">
                Източници
            </a>
        </div>
    </div>

    <partial name="_DemoNotice" />

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Население</div>
                <div class="kpi-value">@Model.Population.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG"))</div>
                <div class="kpi-meta">Жители</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Общо разходи (демо)</div>
                <div class="kpi-value">@MoneyFormatter.FormatThousandEur(Model.TotalDemoSpending)</div>
                <div class="kpi-meta">Сбор по всички области на разходи</div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="kpi-card">
                <div class="kpi-label">Статус на данните</div>
                <div class="kpi-value">Демо</div>
                <div class="kpi-meta">Прототипни регионални данни</div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-start mb-3">
                        <div>
                            <h2 class="card-heading h5">Разходи по области</h2>
                            <p class="text-muted small mb-0">
                                За какво отиват парите в областта?
                            </p>
                        </div>

                        <span class="status-badge status-demo">Демо данни</span>
                    </div>

                    <canvas id="regionChart" data-region-slug="@Model.Slug"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Какво означава това?</h2>

                    <p class="text-muted">
                        Разходите са групирани в разбираеми области — образование, здравеопазване,
                        инфраструктура и социално подпомагане.
                    </p>

                    <div class="explanation-list">
                        <div>
                            <strong>Общо разходи</strong>
                            <span>Сборът на всички демо стойности за областта.</span>
                        </div>

                        <div>
                            <strong>Графиката</strong>
                            <span>Показва кои области получават най-голям дял.</span>
                        </div>

                        <div>
                            <strong>Статус</strong>
                            <span>Регионалните стойности са прототипни, не са официални общински данни.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Профил на областта</h2>

                    <dl class="region-profile">
                        <dt>Област</dt>
                        <dd>@Model.Name</dd>

                        <dt>Бюджетна година</dt>
                        <dd>@Model.BudgetYear</dd>

                        <dt>Население</dt>
                        <dd>@Model.Population.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG"))</dd>

                        <dt>Статус на данните</dt>
                        <dd><span class="status-badge status-demo">Демо данни</span></dd>

                        <dt>Описание</dt>
                        <dd>@Model.Description</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Следващи стъпки</h2>

                    <p class="text-muted">
                        В пълната версия тази страница ще използва официални общински и областни данни,
                        разходи на човек, сравнение по години и препратки към източниците.
                    </p>

                    <div class="product-roadmap-list">
                        <span>Разходи на човек</span>
                        <span>Сравнение по години</span>
                        <span>Официални източници</span>
                        <span>Сравнение с друга област</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/region-details.js"></script>
}