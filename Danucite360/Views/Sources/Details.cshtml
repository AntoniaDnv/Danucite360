@model Danucite360.Services.Models.SourceServiceModel

@{
    ViewData["Title"] = "Източник";
}

<section class="page-shell">
    <div class="mb-4">
        <a class="text-decoration-none fw-semibold"
           asp-controller="Sources"
           asp-action="Index">
            ← Всички източници
        </a>
    </div>

    <div class="page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-official">Официален източник</span>
                <span class="last-updated">Въведено: @Model.RetrievedOn.ToString("dd.MM.yyyy")</span>
            </div>

            <h1 class="section-title mb-2">@Model.Title</h1>

            <p class="section-subtitle mb-0">
                Информация за документа-източник и как се използва.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Данни за документа</h2>

                    <dl class="source-details-list">
                        <dt>Заглавие</dt>
                        <dd>@Model.Title</dd>

                        <dt>Издател</dt>
                        <dd>@Model.Publisher</dd>

                        <dt>Препратка</dt>
                        <dd>@Model.Url</dd>

                        <dt>Публикуван на</dt>
                        <dd>@(Model.PublishedOn?.ToString("yyyy-MM-dd") ?? "Not specified")</dd>

                        <dt>Въведен на</dt>
                        <dd>@Model.RetrievedOn.ToString("yyyy-MM-dd")</dd>

                        <dt>Бележки</dt>
                        <dd>@Model.Notes</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="app-card mb-4">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Статус</h2>

                    <span class="status-badge status-official mb-3">Официален източник</span>

                    <p class="text-muted mb-0">
                        Документът е основа за официалните национални бюджетни стойности.
                        Регионалните стойности в прототипа остават демонстрационни.
                    </p>
                </div>
            </div>

            <div class="app-card">
                <div class="app-card-body">
                    <h2 class="card-heading h5">Как се използва</h2>

                    <div class="methodology-list">
                        <div>
                            <strong>Национални стойности</strong>
                            <span>Въведени ръчно от документа.</span>
                        </div>

                        <div>
                            <strong>Регионални стойности</strong>
                            <span>Само демонстрационни в този прототип.</span>
                        </div>

                        <div>
                            <strong>Следващи стъпки</strong>
                            <span>Качване на документи, проверка от втори човек и контрол на публикуването.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>