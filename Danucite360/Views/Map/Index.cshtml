@model IEnumerable<Danucite360.Services.Models.RegionListServiceModel>

@{
    ViewData["Title"] = "Regional Comparison";
    var regions = Model.ToList();

    // TotalDemoSpending is in "thousand EUR".
    decimal SpendMillions(decimal thousandEur) => thousandEur / 1_000m;
    decimal PerCapitaEur(Danucite360.Services.Models.RegionListServiceModel r)
        => r.Population > 0 ? r.TotalDemoSpending * 1_000m / r.Population : 0m;

    var byPerCapita = regions
        .Select(r => new { r.Name, r.Slug, r.Population, r.TotalDemoSpending, PerCapita = PerCapitaEur(r) })
        .OrderByDescending(r => r.PerCapita)
        .ToList();

    var topPerCapita = byPerCapita.Take(5).ToList();
    var chartLabels = System.Text.Json.JsonSerializer.Serialize(topPerCapita.Select(r => r.Name));
    var chartValues = System.Text.Json.JsonSerializer.Serialize(topPerCapita.Select(r => Math.Round(r.PerCapita, 0)));
}

<section class="page-shell">
    <div class="page-header mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-demo">⚠ Demo Data</span>
                <span class="last-updated">Last updated: 28 May 2026</span>
            </div>
            <h1 class="section-title mb-2">Regional Comparison</h1>
            <p class="section-subtitle mb-0">
                Comparative analysis of public expenditure across Bulgarian regions.
            </p>
        </div>
        <div class="page-actions">
            <span class="status-badge status-draft">⛁ Source: Ministry of Finance</span>
        </div>
    </div>

    <div class="filter-bar app-card mb-4">
        <div class="app-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small text-muted">Search region</label>
                    <input id="regionSearch" type="search" class="form-control" placeholder="Search region..." />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted">Year</label>
                    <select class="form-select"><option selected>2026</option></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small text-muted">Data status</label>
                    <select class="form-select"><option selected>Demo regional data</option></select>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body d-flex flex-column">
                    <h5 class="card-heading">Geographic Distribution</h5>
                    <div class="map-placeholder flex-grow-1">
                        <div class="map-placeholder-inner">
                            <div class="map-pin">⌖</div>
                            <p>Interactive map available in the full application.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body d-flex flex-column">
                    <h5 class="card-heading">Top 5 Regions: Spending per Capita (EUR)</h5>
                    <p class="text-muted small">Demo spending divided by population, in EUR per resident.</p>
                    <div class="region-chart flex-grow-1">
                        <canvas id="perCapitaChart"
                                data-labels='@Html.Raw(chartLabels)'
                                data-values='@Html.Raw(chartValues)'></canvas>
                    </div>
                    <div class="source-ref">Source: Danucite360 demo distribution</div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h5 class="card-heading">Detailed Regional Data</h5>
                    <p class="text-muted small mb-0">Select a region to open its full spending dashboard.</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle" id="regionsTable">
                    <thead>
                        <tr>
                            <th>Region</th>
                            <th class="num">Population</th>
                            <th class="num">Spending (€M)</th>
                            <th class="num">Per Capita (EUR)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in byPerCapita)
                        {
                            <tr data-region-name="@r.Name.ToLowerInvariant()">
                                <td>
                                    <a class="fw-semibold text-decoration-none" href="/regions/@r.Slug">@r.Name</a>
                                </td>
                                <td class="num">@r.Population.ToString("N0")</td>
                                <td class="num">@SpendMillions(r.TotalDemoSpending).ToString("N1")</td>
                                <td class="num">€@PerCapitaEur(regions.First(x => x.Slug == r.Slug)).ToString("N0")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/chart-theme.js" asp-append-version="true"></script>
    <script src="~/js/regions-compare.js" asp-append-version="true"></script>
}
