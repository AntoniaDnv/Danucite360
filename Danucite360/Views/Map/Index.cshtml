@model IEnumerable<Danucite360.Services.Models.RegionListServiceModel>

@{
    ViewData["Title"] = "Сравнение на областите";
    var regions = Model.ToList();

    // TotalDemoSpending is in "thousand EUR".
    decimal SpendMillions(decimal thousandEur) => thousandEur / 1_000m;
    decimal PerCapitaEur(Danucite360.Services.Models.RegionListServiceModel r)
        => r.Population > 0 ? r.TotalDemoSpending * 1_000m / r.Population : 0m;

    var byPerCapita = regions
        .Select(r => new { r.Name, r.Slug, r.Population, r.TotalDemoSpending, PerCapita = PerCapitaEur(r) })
        .OrderByDescending(r => r.PerCapita)
        .ToList();

    var topPerCapita = byPerCapita.Take(5).ToList();
    var chartLabels = System.Text.Json.JsonSerializer.Serialize(topPerCapita.Select(r => r.Name));
    var chartValues = System.Text.Json.JsonSerializer.Serialize(topPerCapita.Select(r => Math.Round(r.PerCapita, 0)));
}

<section class="page-shell">
    <div class="page-header mb-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-demo">Демо данни</span>
                <span class="last-updated">Бюджет 2026</span>
            </div>
            <h1 class="section-title mb-2">Сравнение на областите</h1>
            <p class="section-subtitle mb-0">
                Колко публични средства се харчат на човек в различните области (демонстрационни стойности).
            </p>
        </div>
        <div class="page-actions">
            <span class="status-badge status-demo">Демонстрационни регионални данни</span>
        </div>
    </div>

    <div class="filter-bar app-card mb-4">
        <div class="app-card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted" for="regionSearch">Търсене</label>
                    <input id="regionSearch" type="search" class="form-control" placeholder="Търсене на област…" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted" for="regionYear">Година</label>
                    <select id="regionYear" class="form-select"><option selected>2026</option></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted" for="regionStatus">Статус на данните</label>
                    <select id="regionStatus" class="form-select">
                        <option value="all" selected>Всички</option>
                        <option value="demo">Демо</option>
                        <option value="official">Официални</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted" for="regionSort">Подреди по</label>
                    <select id="regionSort" class="form-select">
                        <option value="percapita" selected>На човек</option>
                        <option value="spending">Общо разходи</option>
                        <option value="population">Население</option>
                        <option value="name">Име</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="app-card h-100">
                <div class="app-card-body d-flex flex-column">
                    <h2 class="card-heading h5">На картата</h2>
                    <div class="map-placeholder flex-grow-1">
                        <div class="map-placeholder-inner">
                            <p>Вижте публичните проекти по области на интерактивната карта.</p>
                            <a class="btn btn-primary btn-sm" href="/projects/map">Отвори картата на проектите</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="app-card h-100">
                <div class="app-card-body d-flex flex-column">
                    <h2 class="card-heading h5">Топ 5 области: разходи на човек (€)</h2>
                    <p class="text-muted small">Демо разходите, разделени на броя жители.</p>
                    <div class="region-chart flex-grow-1">
                        <canvas id="perCapitaChart"
                                data-labels='@Html.Raw(chartLabels)'
                                data-values='@Html.Raw(chartValues)'></canvas>
                    </div>
                    <div class="source-ref demo">Източник: демонстрационно разпределение</div>
                </div>
            </div>
        </div>
    </div>

    <div class="app-card">
        <div class="app-card-body">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <h2 class="card-heading h5">Данни по области</h2>
                    <p class="text-muted small mb-0">Изберете област, за да видите подробностите.</p>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table align-middle" id="regionsTable">
                    <thead>
                        <tr>
                            <th>Област</th>
                            <th class="num">Население</th>
                            <th class="num">Разходи (млн. €)</th>
                            <th class="num">На човек (€)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in byPerCapita)
                        {
                            <tr data-region-name="@r.Name.ToLowerInvariant()"
                                data-status="demo"
                                data-percapita="@Math.Round(r.PerCapita, 0)"
                                data-spending="@Math.Round(SpendMillions(r.TotalDemoSpending), 1)"
                                data-population="@r.Population">
                                <td>
                                    <a class="fw-semibold text-decoration-none" href="/regions/@r.Slug">@r.Name</a>
                                </td>
                                <td class="num">@r.Population.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG"))</td>
                                <td class="num">@SpendMillions(r.TotalDemoSpending).ToString("N1", System.Globalization.CultureInfo.GetCultureInfo("bg-BG"))</td>
                                <td class="num">@r.PerCapita.ToString("N0", System.Globalization.CultureInfo.GetCultureInfo("bg-BG"))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div id="regionsEmptyState" class="empty-state d-none">
                <h5>Няма области по тези критерии.</h5>
                <p>Променете търсенето или статуса на данните.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
    <script src="~/js/chart-theme.js" asp-append-version="true"></script>
    <script src="~/js/regions-compare.js" asp-append-version="true"></script>
}
