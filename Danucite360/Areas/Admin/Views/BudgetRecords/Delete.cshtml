@model Danucite360.Data.Models.BudgetRecord

@{
    ViewData["Title"] = "Изтриване на бюджетен запис";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4 text-danger">Изтриване на бюджетен запис</h1>

    <div class="alert alert-warning">
        Сигурни ли сте, че искате да изтриете този запис?
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <p><strong>Вид:</strong> @Model.RecordType</p>
            <p><strong>Област:</strong> @(Model.Region?.Name ?? "National")</p>
            <p><strong>Категория:</strong> @Model.BudgetCategory.Name</p>
            <p><strong>Сума:</strong> @Model.Amount.ToString("N1") @Model.Unit</p>

            <form asp-area="Admin"
                  asp-controller="BudgetRecords"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">Изтрий</button>

                <a class="btn btn-outline-secondary"
                   asp-area="Admin"
                   asp-controller="BudgetRecords"
                   asp-action="Index">
                    Отказ
                </a>
            </form>
        </div>
    </div>
</div>  