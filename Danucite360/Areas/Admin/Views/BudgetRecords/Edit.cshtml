@model Danucite360.Web.ViewModels.Admin.BudgetRecordInputModel

@{
    ViewData["Title"] = "Редакция на бюджетен запис";
}

<section class="admin-shell">
    <div class="admin-page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-official">Администратор</span>
                <span class="last-updated">Редакция на съществуващ запис</span>
            </div>

            <h1 class="section-title mb-2">Редакция на бюджетен запис</h1>

            <p class="section-subtitle mb-0">
                Променете стойност, използвана в публичните графики.
            </p>
        </div>

        <div class="page-actions">
            <a class="btn btn-outline-primary btn-sm"
               asp-area="Admin"
               asp-controller="BudgetRecords"
               asp-action="Index">
                Към записите
            </a>
        </div>
    </div>

    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-title">Администрация</div>

            <nav class="admin-nav">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Табло</a>
                <a asp-area="Admin" asp-controller="Regions" asp-action="Index">Области</a>
                <a class="active" asp-area="Admin" asp-controller="BudgetRecords" asp-action="Index">Бюджетни записи</a>
                <a asp-area="" asp-controller="Sources" asp-action="Index">Източници</a>
            </nav>

            <div class="admin-sidebar-note">
                <strong>Внимание</strong>
                <span>Промените тук се показват на публичните страници след запис.</span>
            </div>
        </aside>

        <div class="admin-content">
            <form method="post">
                @Html.AntiForgeryToken()

                <div class="row g-4">
                    <div class="col-lg-8">
                        <div class="app-card mb-4">
                            <div class="app-card-body">
                                <h5 class="card-heading">Данни за записа</h5>
                                <p class="text-muted small">
                                    Редакция на сумата, категорията, източника и статуса на записа.
                                </p>

                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label asp-for="BudgetYear" class="form-label"></label>
                                        <input asp-for="BudgetYear" class="form-control" />
                                        <span asp-validation-for="BudgetYear" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="RecordType" class="form-label"></label>
                                        <select asp-for="RecordType" asp-items="Model.RecordTypes" class="form-select"></select>
                                        <span asp-validation-for="RecordType" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="Amount" class="form-label"></label>
                                        <input asp-for="Amount" class="form-control" />
                                        <span asp-validation-for="Amount" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="Currency" class="form-label"></label>
                                        <input asp-for="Currency" class="form-control" />
                                        <span asp-validation-for="Currency" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="Unit" class="form-label"></label>
                                        <input asp-for="Unit" class="form-control" />
                                        <span asp-validation-for="Unit" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-4">
                                        <label asp-for="RegionId" class="form-label">Област</label>
                                        <select asp-for="RegionId" asp-items="Model.Regions" class="form-select">
                                            <option value="">Национален / без област</option>
                                        </select>
                                        <span asp-validation-for="RegionId" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="BudgetCategoryId" class="form-label">Категория</label>
                                        <select asp-for="BudgetCategoryId" asp-items="Model.Categories" class="form-select"></select>
                                        <span asp-validation-for="BudgetCategoryId" class="text-danger"></span>
                                    </div>

                                    <div class="col-md-6">
                                        <label asp-for="BudgetSourceId" class="form-label">Източник</label>
                                        <select asp-for="BudgetSourceId" asp-items="Model.Sources" class="form-select"></select>
                                        <span asp-validation-for="BudgetSourceId" class="text-danger"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="Notes" class="form-label"></label>
                                        <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
                                        <span asp-validation-for="Notes" class="text-danger"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="app-card">
                            <div class="app-card-body">
                                <h5 class="card-heading">Статус на данните</h5>

                                <div class="form-check form-switch">
                                    <input asp-for="IsDemo" class="form-check-input" />
                                    <label asp-for="IsDemo" class="form-check-label">
                                        Отбележи като демо данни
                                    </label>
                                </div>

                                <span asp-validation-for="IsDemo" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4">
                        <div class="app-card mb-4">
                            <div class="app-card-body">
                                <h5 class="card-heading">Указания</h5>

                                <div class="methodology-list">
                                    <div>
                                        <strong>Ефект върху публичните страници</strong>
                                        <span>Промяната на стойността веднага се отразява в публичните графики.</span>
                                    </div>

                                    <div>
                                        <strong>Регионални данни</strong>
                                        <span>Регионалните стойности остават отбелязани като демо данни.</span>
                                    </div>

                                    <div>
                                        <strong>Източник</strong>
                                        <span>Не прекъсвайте връзката между стойността и източника.</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="sticky-action-card app-card">
                            <div class="app-card-body">
                                <h5 class="card-heading">Запази промените</h5>
                                <p class="text-muted small">
                                    Проверете преди запис — публичните страници четат тези данни.
                                </p>

                                <button type="submit" class="btn btn-primary w-100 mb-2">
                                    Запази промените
                                </button>

                                <a class="btn btn-outline-secondary w-100"
                                   asp-area="Admin"
                                   asp-controller="BudgetRecords"
                                   asp-action="Index">
                                    Отказ
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}