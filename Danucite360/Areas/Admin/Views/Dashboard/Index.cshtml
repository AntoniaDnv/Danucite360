@model Danucite360.Web.ViewModels.Admin.AdminDashboardViewModel

@{
    ViewData["Title"] = "Администрация";
}

<section class="admin-shell">
    <div class="admin-page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-official">Администратор</span>
                <span class="last-updated">Budget year @Model.BudgetYear</span>
            </div>

            <h1 class="section-title mb-2">Администрация</h1>

            <p class="section-subtitle mb-0">
                Управление на бюджетните записи и демо данните, за да са точни публичните страници.
            </p>
        </div>

        <div class="page-actions">
            <a class="btn btn-primary btn-sm"
               asp-area="Admin"
               asp-controller="BudgetRecords"
               asp-action="Create">
                Нов бюджетен запис
            </a>

            <a class="btn btn-outline-primary btn-sm"
               asp-area=""
               asp-controller="Home"
               asp-action="Index">
                Публичен сайт
            </a>
        </div>
    </div>

    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-title">Администрация</div>

            <nav class="admin-nav">
                <a class="active"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Табло
                </a>

                <a asp-area="Admin"
                   asp-controller="Regions"
                   asp-action="Index">
                    Области
                </a>

                <a asp-area="Admin"
                   asp-controller="BudgetRecords"
                   asp-action="Index">
                    Бюджетни записи
                </a>

                <a asp-area=""
                   asp-controller="Sources"
                   asp-action="Index">
                    Източници
                </a>
            </nav>

            <div class="admin-sidebar-note">
                <strong>Прототип</strong>
                <span>Регионалните данни засега са демонстрационни.</span>
            </div>
        </aside>

        <div class="admin-content">
            <div class="row g-4 mb-4">
                <div class="col-md-4">
                    <div class="admin-metric-card">
                        <div class="kpi-icon kpi-icon-blue">◎</div>
                        <div class="kpi-label">Области</div>
                        <div class="kpi-value">@Model.RegionsCount</div>
                        <div class="kpi-meta">Прототипни области</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="admin-metric-card">
                        <div class="kpi-icon kpi-icon-green">▦</div>
                        <div class="kpi-label">Категории</div>
                        <div class="kpi-value">@Model.CategoriesCount</div>
                        <div class="kpi-meta">Бюджетни категории</div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="admin-metric-card">
                        <div class="kpi-icon kpi-icon-blue">Σ</div>
                        <div class="kpi-label">Бюджетни записи</div>
                        <div class="kpi-value">@Model.BudgetRecordsCount</div>
                        <div class="kpi-meta">Записи в базата</div>
                    </div>
                </div>
            </div>

            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <div class="app-card h-100">
                        <div class="app-card-body">
                            <h5 class="card-heading">Качество на данните</h5>
                            <p class="text-muted small">
                                Състояние на данните.
                            </p>

                            <div class="confidence-row">
                                <div class="confidence-label">
                                    <span class="confidence-dot official"></span>
                                    Документи-източници
                                </div>
                                <div class="confidence-bar">
                                    <span style="width: 100%" class="official"></span>
                                </div>
                                <strong>@Model.SourcesCount</strong>
                            </div>

                            <div class="confidence-row">
                                <div class="confidence-label">
                                    <span class="confidence-dot demo"></span>
                                    Демо записи
                                </div>
                                <div class="confidence-bar">
                                    @{
                                        var demoPercent = Model.BudgetRecordsCount == 0
                                            ? 0
                                            : (Model.DemoRecordsCount * 100 / Model.BudgetRecordsCount);
                                    }
                                    <span style="width:@demoPercent%" class="demo"></span>
                                </div>
                                <strong>@Model.DemoRecordsCount</strong>
                            </div>

                            <div class="methodology-note mt-4">
                                <strong>Бележка:</strong>
                                Бюджетните записи определят какво показват публичните графики. Редакцията се отразява веднага.
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="app-card h-100">
                        <div class="app-card-body">
                            <h5 class="card-heading">Бързи действия</h5>
                            <p class="text-muted small">
                                Чести задачи по поддръжката на данните.
                            </p>

                            <div class="quick-action-list">
                                <a asp-area="Admin"
                                   asp-controller="BudgetRecords"
                                   asp-action="Create">
                                    <strong>Нов бюджетен запис</strong>
                                    <span>Нов национален или регионален бюджетен запис.</span>
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="BudgetRecords"
                                   asp-action="Index">
                                    <strong>Преглед на бюджетните записи</strong>
                                    <span>Редакция на данните зад графиките, свързани с източник.</span>
                                </a>

                                <a asp-area="Admin"
                                   asp-controller="Regions"
                                   asp-action="Index">
                                    <strong>Области</strong>
                                    <span>Създаване, редакция и преглед на областите.</span>
                                </a>

                                <a asp-area=""
                                   asp-controller="Sources"
                                   asp-action="Index">
                                    <strong>Източници</strong>
                                    <span>Преглед на публичните страници с източници и методология.</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-card">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                        <div>
                            <h5 class="card-heading">Препоръчани следващи подобрения</h5>
                            <p class="text-muted small mb-0">
                                Не са нужни за прототипа, но подготвят следващата версия.
                            </p>
                        </div>

                        <span class="status-badge status-review">Следващи стъпки</span>
                    </div>

                    <div class="product-roadmap-list">
                        <span>Публикуване / скриване на записи</span>
                        <span>Качване на документи-източници</span>
                        <span>Финансирани проекти по категории</span>
                        <span>История на промените</span>
                        <span>Сравнение по години</span>
                        <span>Български език</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>