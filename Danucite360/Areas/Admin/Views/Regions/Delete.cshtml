@model Danucite360.Data.Models.Region

@{
    ViewData["Title"] = "Изтриване на област";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4 text-danger">Изтриване на област</h1>

    <div class="alert alert-warning">
        Сигурни ли сте, че искате да изтриете <strong>@Model.Name</strong>?
        Възможно е само ако областта няма бюджетни записи.
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <p><strong>Име:</strong> @Model.Name</p>
            <p><strong>Адрес (slug):</strong> @Model.Slug</p>
            <p><strong>Население:</strong> @Model.Population.ToString("N0")</p>

            <form asp-area="Admin"
                  asp-controller="Regions"
                  asp-action="DeleteConfirmed"
                  asp-route-id="@Model.Id"
                  method="post">
                @Html.AntiForgeryToken()

                <button type="submit" class="btn btn-danger">Изтрий</button>

                <a class="btn btn-outline-secondary"
                   asp-area="Admin"
                   asp-controller="Regions"
                   asp-action="Index">
                    Отказ
                </a>
            </form>
        </div>
    </div>
</div>