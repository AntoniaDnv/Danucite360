@model Danucite360.Data.Models.Region

@{
    ViewData["Title"] = "Област";
}

<div class="container py-5">
    <h1 class="fw-bold mb-4">@Model.Name</h1>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Име</dt>
                <dd class="col-sm-9">@Model.Name</dd>

                <dt class="col-sm-3">Адрес (slug)</dt>
                <dd class="col-sm-9">@Model.Slug</dd>

                <dt class="col-sm-3">Население</dt>
                <dd class="col-sm-9">@Model.Population.ToString("N0")</dd>

                <dt class="col-sm-3">Демо</dt>
                <dd class="col-sm-9">@(Model.IsDemo ? "Yes" : "No")</dd>

                <dt class="col-sm-3">Описание</dt>
                <dd class="col-sm-9">@Model.Description</dd>
            </dl>

            <a class="btn btn-primary"
               asp-area="Admin"
               asp-controller="Regions"
               asp-action="Edit"
               asp-route-id="@Model.Id">
                Редактирай
            </a>

            <a class="btn btn-outline-secondary"
               asp-area="Admin"
               asp-controller="Regions"
               asp-action="Index">
                Назад
            </a>
        </div>
    </div>
</div>