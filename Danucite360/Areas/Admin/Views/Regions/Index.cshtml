@model IEnumerable<Danucite360.Data.Models.Region>

@{
    ViewData["Title"] = "Области";
    var regions = Model.ToList();

    var demoCount = regions.Count(r => r.IsDemo);
    var officialCount = regions.Count(r => !r.IsDemo);
    var totalPopulation = regions.Sum(r => r.Population);
}

<section class="admin-shell">
    <div class="admin-page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-official">Администратор</span>
                <span class="last-updated">Управление на областите</span>
            </div>

            <h1 class="section-title mb-2">Области</h1>

            <p class="section-subtitle mb-0">
                Създаване, преглед и управление на областите в публичните страници.
            </p>
        </div>

        <div class="page-actions">
            <a class="btn btn-primary btn-sm"
               asp-area="Admin"
               asp-controller="Regions"
               asp-action="Create">
                Нова област
            </a>

            <a class="btn btn-outline-primary btn-sm"
               asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">
                Табло
            </a>
        </div>
    </div>

    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-title">Администрация</div>

            <nav class="admin-nav">
                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Табло
                </a>

                <a class="active"
                   asp-area="Admin"
                   asp-controller="Regions"
                   asp-action="Index">
                    Области
                </a>

                <a asp-area="Admin"
                   asp-controller="BudgetRecords"
                   asp-action="Index">
                    Бюджетни записи
                </a>

                <a asp-area=""
                   asp-controller="Sources"
                   asp-action="Index">
                    Източници
                </a>
            </nav>

            <div class="admin-sidebar-note">
                <strong>Правило за областите</strong>
                <span>Заредените области са демонстрационни и служат за визуализация.</span>
            </div>
        </aside>

        <div class="admin-content">
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Всички области</div>
                        <div class="kpi-value">@regions.Count</div>
                        <div class="kpi-meta">Общо записи за области</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Демо области</div>
                        <div class="kpi-value">@demoCount</div>
                        <div class="kpi-meta">Прототипни области</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Официални области</div>
                        <div class="kpi-value">@officialCount</div>
                        <div class="kpi-meta">Проверени записи за области</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Население</div>
                        <div class="kpi-value">@totalPopulation.ToString("N0")</div>
                        <div class="kpi-meta">Общо население</div>
                    </div>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="filter-bar app-card mb-4">
                <div class="app-card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small text-muted">Търсене на области</label>
                            <input id="regionAdminSearch"
                                   type="search"
                                   class="form-control"
                                   placeholder="Търсене по име или описание…" />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small text-muted">Статус на данните</label>
                            <select id="regionStatusFilter" class="form-select">
                                <option value="all" selected>Всички</option>
                                <option value="demo">Демо</option>
                                <option value="official">Официални</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small text-muted">Подреди по</label>
                            <select id="regionSort" class="form-select">
                                <option value="name" selected>Име</option>
                                <option value="population">Население</option>
                            </select>
                        </div>

                        <div class="col-md-2 text-md-end">
                            <button id="resetRegionFilters" type="button" class="btn btn-outline-secondary w-100">
                                Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-card">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                        <div>
                            <h5 class="card-heading">Записи за области</h5>
                            <p class="text-muted small mb-0">
                                Областите се използват в публичните страници за регионите.
                            </p>
                        </div>

                        <span class="status-badge status-demo">Демонстрационен набор данни</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table admin-data-table align-middle">
                            <thead>
                                <tr>
                                    <th>Област</th>
                                    <th>Адрес (slug)</th>
                                    <th class="text-end">Население</th>
                                    <th>Статус</th>
                                    <th>Описание</th>
                                    <th class="text-end">Действия</th>
                                </tr>
                            </thead>

                            <tbody id="regionsTableBody">
                                @foreach (var region in regions.OrderBy(r => r.Name))
                                {
                                    var status = region.IsDemo ? "demo" : "official";

                                    <tr data-region-row
                                        data-search="@($"{region.Name} {region.Slug} {region.Description}".ToLowerInvariant())"
                                        data-status="@status"
                                        data-name="@region.Name.ToLowerInvariant()"
                                        data-population="@region.Population">
                                        <td>
                                            <div class="record-title">@region.Name</div>
                                            <div class="record-subtitle">Region ID: @region.Id</div>
                                        </td>

                                        <td>
                                            <code>@region.Slug</code>
                                        </td>

                                        <td class="text-end">
                                            <div class="record-amount">@region.Population.ToString("N0")</div>
                                            <div class="record-subtitle">души</div>
                                        </td>

                                        <td>
                                            @if (region.IsDemo)
                                            {
                                                <span class="status-badge status-demo">Демо</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-official">Официални</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="source-short">@region.Description</div>
                                        </td>

                                        <td class="text-end">
                                            <div class="table-actions">
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-area="Admin"
                                                   asp-controller="Regions"
                                                   asp-action="Details"
                                                   asp-route-id="@region.Id">
                                                    Детайли
                                                </a>

                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-area="Admin"
                                                   asp-controller="Regions"
                                                   asp-action="Edit"
                                                   asp-route-id="@region.Id">
                                                    Редактирай
                                                </a>

                                                <a class="btn btn-sm btn-outline-danger"
                                                   asp-area="Admin"
                                                   asp-controller="Regions"
                                                   asp-action="Delete"
                                                   asp-route-id="@region.Id">
                                                    Изтрий
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="regionsEmptyState" class="empty-state d-none">
                        <div class="empty-state-icon">🔍</div>
                        <h5>Няма области по тези критерии.</h5>
                        <p>Променете търсенето, статуса или подредбата.</p>
                    </div>

                    <div class="mt-4">
                        <a class="btn btn-outline-secondary"
                           asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Към таблото
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin-regions.js" asp-append-version="true"></script>
}