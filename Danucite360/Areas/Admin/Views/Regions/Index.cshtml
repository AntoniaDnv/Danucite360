@model IEnumerable<Danucite360.Data.Models.Region>

@{
    ViewData["Title"] = "Manage Regions";
    var regions = Model.ToList();

    var demoCount = regions.Count(r => r.IsDemo);
    var officialCount = regions.Count(r => !r.IsDemo);
    var totalPopulation = regions.Sum(r => r.Population);
}

<section class="admin-shell">
    <div class="admin-page-header mb-4">
        <div>
            <div class="d-flex align-items-center gap-2 mb-2">
                <span class="status-badge status-official">✓ Admin</span>
                <span class="last-updated">Region management</span>
            </div>

            <h1 class="section-title mb-2">Regions</h1>

            <p class="section-subtitle mb-0">
                Create, review, and manage the regions used in Danucite360’s public dashboard.
            </p>
        </div>

        <div class="page-actions">
            <a class="btn btn-primary btn-sm"
               asp-area="Admin"
               asp-controller="Regions"
               asp-action="Create">
                Create Region
            </a>

            <a class="btn btn-outline-primary btn-sm"
               asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index">
                Dashboard
            </a>
        </div>
    </div>

    <div class="admin-layout">
        <aside class="admin-sidebar">
            <div class="admin-sidebar-title">Admin</div>

            <nav class="admin-nav">
                <a asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    Dashboard
                </a>

                <a class="active"
                   asp-area="Admin"
                   asp-controller="Regions"
                   asp-action="Index">
                    Regions
                </a>

                <a asp-area="Admin"
                   asp-controller="BudgetRecords"
                   asp-action="Index">
                    Budget Records
                </a>

                <a asp-area=""
                   asp-controller="Sources"
                   asp-action="Index">
                    Sources
                </a>
            </nav>

            <div class="admin-sidebar-note">
                <strong>Region rule</strong>
                <span>Seeded MVP regions are demo regions used for prototype visualization.</span>
            </div>
        </aside>

        <div class="admin-content">
            <div class="row g-4 mb-4">
                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">All Regions</div>
                        <div class="kpi-value">@regions.Count</div>
                        <div class="kpi-meta">Total region records</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Demo Regions</div>
                        <div class="kpi-value">@demoCount</div>
                        <div class="kpi-meta">Prototype regions</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Official Regions</div>
                        <div class="kpi-value">@officialCount</div>
                        <div class="kpi-meta">Verified region records</div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="admin-metric-card">
                        <div class="kpi-label">Population</div>
                        <div class="kpi-value">@totalPopulation.ToString("N0")</div>
                        <div class="kpi-meta">Combined population</div>
                    </div>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger">
                    @TempData["ErrorMessage"]
                </div>
            }

            <div class="filter-bar app-card mb-4">
                <div class="app-card-body">
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label small text-muted">Search regions</label>
                            <input id="regionAdminSearch"
                                   type="search"
                                   class="form-control"
                                   placeholder="Search by name, slug, or description..." />
                        </div>

                        <div class="col-md-3">
                            <label class="form-label small text-muted">Data status</label>
                            <select id="regionStatusFilter" class="form-select">
                                <option value="all" selected>All</option>
                                <option value="demo">Demo</option>
                                <option value="official">Official</option>
                            </select>
                        </div>

                        <div class="col-md-2">
                            <label class="form-label small text-muted">Sort by</label>
                            <select id="regionSort" class="form-select">
                                <option value="name" selected>Name</option>
                                <option value="population">Population</option>
                            </select>
                        </div>

                        <div class="col-md-2 text-md-end">
                            <button id="resetRegionFilters" type="button" class="btn btn-outline-secondary w-100">
                                Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="app-card">
                <div class="app-card-body">
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
                        <div>
                            <h5 class="card-heading">Region records</h5>
                            <p class="text-muted small mb-0">
                                Regions are used by the public region selector and regional spending pages.
                            </p>
                        </div>

                        <span class="status-badge status-demo">⚠ MVP demo dataset</span>
                    </div>

                    <div class="table-responsive">
                        <table class="table admin-data-table align-middle">
                            <thead>
                                <tr>
                                    <th>Region</th>
                                    <th>Slug</th>
                                    <th class="text-end">Population</th>
                                    <th>Status</th>
                                    <th>Description</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>

                            <tbody id="regionsTableBody">
                                @foreach (var region in regions.OrderBy(r => r.Name))
                                {
                                    var status = region.IsDemo ? "demo" : "official";

                                    <tr data-region-row
                                        data-search="@($"{region.Name} {region.Slug} {region.Description}".ToLowerInvariant())"
                                        data-status="@status"
                                        data-name="@region.Name.ToLowerInvariant()"
                                        data-population="@region.Population">
                                        <td>
                                            <div class="record-title">@region.Name</div>
                                            <div class="record-subtitle">Region ID: @region.Id</div>
                                        </td>

                                        <td>
                                            <code>@region.Slug</code>
                                        </td>

                                        <td class="text-end">
                                            <div class="record-amount">@region.Population.ToString("N0")</div>
                                            <div class="record-subtitle">people</div>
                                        </td>

                                        <td>
                                            @if (region.IsDemo)
                                            {
                                                <span class="status-badge status-demo">⚠ Demo</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-official">✓ Official</span>
                                            }
                                        </td>

                                        <td>
                                            <div class="source-short">@region.Description</div>
                                        </td>

                                        <td class="text-end">
                                            <div class="table-actions">
                                                <a class="btn btn-sm btn-outline-secondary"
                                                   asp-area="Admin"
                                                   asp-controller="Regions"
                                                   asp-action="Details"
                                                   asp-route-id="@region.Id">
                                                    Details
                                                </a>

                                                <a class="btn btn-sm btn-outline-primary"
                                                   asp-area="Admin"
                                                   asp-controller="Regions"
                                                   asp-action="Edit"
                                                   asp-route-id="@region.Id">
                                                    Edit
                                                </a>

                                                <a class="btn btn-sm btn-outline-danger"
                                                   asp-area="Admin"
                                                   asp-controller="Regions"
                                                   asp-action="Delete"
                                                   asp-route-id="@region.Id">
                                                    Delete
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div id="regionsEmptyState" class="empty-state d-none">
                        <div class="empty-state-icon">🔍</div>
                        <h5>No regions match your filters.</h5>
                        <p>Try changing the search text, data status, or sort option.</p>
                    </div>

                    <div class="mt-4">
                        <a class="btn btn-outline-secondary"
                           asp-area="Admin"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            Back to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/admin-regions.js" asp-append-version="true"></script>
}